# =========================================================================
# AL FAROUQ AI — Environment configuration (copy to .env and fill values)
# NEVER commit the real .env file. This file is only a template.
# =========================================================================

# --- Server ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Secret used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-hex-string

# --- Database ---
# Local development uses SQLite (zero setup). Production can switch to Postgres
# by mirroring server/src/db/schema.ts as a pg schema (see docs/DECISIONS.md).
DATABASE_URL=./data/alfarouq.sqlite
DB_FILE=./data/alfarouq.sqlite

# --- AI Providers ---
# Selects which LLM provider the app uses: "mock" | "gemini"
AI_LLM_PROVIDER=mock
# Selects the embedding provider: "mock" | "gemini"
AI_EMBEDDING_PROVIDER=mock

# Real provider keys (required only when provider != mock)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# OCR of scanned documents (Path A chats + Path B curriculum import): which provider reads the pages, "mock" | "gemini"
AI_OCR_PROVIDER=mock
# Gemini model used for OCR (pages sent inline as one part — no rasterization yet)
GEMINI_OCR_MODEL=gemini-2.0-flash

# Model routing: default model per capability (used by AI router)
AI_ROUTING_LLM=default
AI_ROUTING_EMBEDDING=default

# --- AI caching (PHASE 22) ---
# Deterministic calls are served from the in-memory LRU instead of the real
# provider: classifier + rerank (LLM), embeddings (same texts -> same vectors),
# OCR (same bytes -> same text). Tutor/recap/feedback stay dynamic (never cached).
# A cache hit records NO usage row (zero provider cost); the first caller of any
# unique input pays for it. Set to false to disable caching entirely.
AI_CACHE_ENABLED=true
# TTL per cached entry (LLM ops)
AI_CACHE_TTL_MS=300000
# Embeddings of the same text array are reused within 1h (re-ingest/dedup scans)
AI_CACHE_EMBEDDING_TTL_MS=3600000
# OCR recognition is immutable per file bytes (24h reuse across users/paths)
AI_CACHE_OCR_TTL_MS=86400000
# LRU capacity shared across the three caches
AI_CACHE_MAX_ENTRIES=256

# --- Cost / usage guardrails ---
# Per-student daily AI message budget (0 = unlimited for local/MVP)
DAILY_MESSAGE_LIMIT=50
# PHASE 20 — premium subscription daily budget (0 = unlimited). Used when the
# student's plan is premium AND active/trialing AND not expired; otherwise the
# DAILY_MESSAGE_LIMIT free budget applies (past_due/cancelled/expired degrade).
PREMIUM_DAILY_MESSAGE_LIMIT=0
# Vision: max photo size attached to a tutor message, in KB (PNG/JPEG/WebP only)
MAX_IMAGE_KB=5000
# Documents (Path A — student files attached in chat): max size, in KB (PDF/DOCX/TXT/MD)
MAX_FILE_KB=10000
# Max characters of extracted document text sent to the tutor (rest is cut with "…")
MAX_DOCUMENT_CHARS=20000
# Curriculum file import (Path B — admin): max file size, in KB (base64 fits the 32MB bodyLimit)
MAX_CURRICULUM_FILE_KB=20480
# Max characters of extracted curriculum text that is chunked + embedded into the knowledge base
MAX_CURRICULUM_DOCUMENT_CHARS=200000
# OCR: cap on recognized text returned by the OCR provider per file (rest is cut with "…")
MAX_OCR_CHARS=20000

# --- Concept mastery (PHASE 24) ---
# Exponential Ebbinghaus decay applied read-only when displaying mastery (student
# dashboard, parent view, practice feedback). 0.02/day ≈ 35-day half-life; 0 = no decay.
# Tutor long-term memory always keeps the RAW mastery value (decay is display-only).
MASTERY_DECAY_PER_DAY=0.02

# --- RAG ---
# Maximum number of context chunks retrieved per query
RAG_TOP_K=5
# Enable reranking step (RAG_SYSTEM.md §1)
RAG_ENABLE_RERANK=true
# Reranker flavor: "lexical" (fast, deterministic, default) | "model" (LLM-scored — operation "rerank", opt-in)
RAG_RERANKER=lexical

# --- Vector store adapter (PHASE 21 — same VectorStore interface, sqlite default) ---
# "sqlite" = local MVP (zero deps, table rag_vectors) | "qdrant" = Qdrant over HTTP (Docker/Qdrant Cloud)
VECTOR_STORE=sqlite
# Qdrant HTTP endpoint (only used when VECTOR_STORE=qdrant)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=alfarouq
# Optional fixed vector dimension; when absent the store adopts the first embedding's dim
QDRANT_DIMENSION=

# --- Frontend ---
WEB_ORIGIN=http://localhost:5173
# Base URL of the API as seen by the browser (used in dev via Vite proxy)
API_BASE_URL=/api

# --- Tests ---
# Set to true ONLY to run live calls against real AI providers (costs money / sends data externally)
RUN_LIVE_TESTS=false