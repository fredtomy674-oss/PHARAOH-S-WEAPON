# Data files (local DB, uploads)
*.sqlite
*.sqlite3
*.db
server/data/*
# The official imported curriculum text (from the Ministry PDF) is authoritative
# source, not runtime state — keep it under version control. The text-layer dir
# holds the pages OCR could not reach, read from the PDF's own embedded text.
!server/data/curriculum-ocr/
!server/data/curriculum-text-layer/
server/uploads/
web/uploads/

# Logs
logs/
*.log
npm-debug.log*

# Playwright artifacts
playwright-report/
test-results/
e2e/.last-demo-session.json

# PHASE 47 dev-time artifacts — transient probes, extracted page JPEGs and logs
# under server/scripts (the committed pipeline lives in tracked .mjs files).
server/scripts/.*
server/scripts/pdf-debug.mjs
server/scripts/pdf-extract-pages.mjs
server/scripts/pdf-inspect.mjs
server/scripts/pdf-probe.mjs
server/scripts/pdf-scan.mjs
server/scripts/ocr-probe.mjs

